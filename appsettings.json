{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Hosting.Internal.Host": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:MM}.{Timestamp:dd}.{Timestamp:yyyy} {Timestamp:HH:mm:ss} {Level:u4} ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp:MM}.{Timestamp:dd}.{Timestamp:yyyy} {Timestamp:HH:mm:ss} {Level:u4} ({SourceContext}) {Message:lj}{NewLine}{Exception}",
          "path": "Logs/Log.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "Origins": [
    "http://localhost:5052",
    "http://localhost:8080",
    "https://ip-deputy-beta.navatuseinlab.uk"
  ],

  "Database": {
    "ConnectionString": "",
    "ApplyMigrationsOnStartup": true
  },

  "AuthorizeJWT": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "LifetimeMinutes": 60
  },

  "RefreshJWT": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "LifetimeDays": 30
  },

  "InitialAdmin": {
    "Login": "",
    "Password": ""
  },

  "Schedule": {
    "TimeZone": "Europe/Kyiv"
  },

  "ReverseProxy": {
    "TrustForwardedHeaders": true
  },

  "BotAuthorizeToken": "",
  "BotToken": "",
  "InitDataLifetimeHours": 24
}
